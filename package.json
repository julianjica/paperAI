{
	"name": "researchai",
	"version": "0.1.0",
	"private": true,
	"license": "AGPL-3.0-only",
	"description": "An Overleaf-like harness where agents rewrite parts of a LaTeX paper.",
	"type": "module",
	"main": "electron/main.cjs",
	"scripts": {
		"dev": "next dev",
		"build": "next build",
		"start": "next start",
		"postinstall": "node scripts/copy-pdf-worker.mjs",
		"test": "RA_DATA_DIR=\"$(mktemp -d)\" NODE_ENV=test tsx --test tests/*.test.ts",
		"typecheck": "tsc --noEmit",
		"desktop:dev": "concurrently -k \"next dev -p 3100\" \"RA_DEV_URL=http://localhost:3100 electron .\"",
		"desktop": "next build && electron ."
	},
	"dependencies": {
		"@anthropic-ai/claude-agent-sdk": "0.3.310",
		"@streamdown/math": "^1.0.2",
		"diff": "^8.0.2",
		"katex": "0.18.2",
		"lucide-react": "^1.33.0",
		"nanoid": "^6.0.1",
		"next": "^16.3.2",
		"pdfjs-dist": "^6.3.289",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"streamdown": "^2.5.0",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@tailwindcss/postcss": "^4.3.3",
		"@types/diff": "^8.0.0",
		"@types/node": "^24.0.0",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.4",
		"concurrently": "^10.0.5",
		"electron": "^44.4.1",
		"tailwindcss": "^4.3.3",
		"tsx": "^4.19.0",
		"typescript": "^5.6.0"
	}
}
